{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CrossDesk",
  "version": "0.4.0",
  "identifier": "local.crossdesk.app",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 1420",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "CrossDesk",
        "width": 640,
        "height": 790,
        "minWidth": 380,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost https://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "nsis"
    ],
    "icon": [
      "assets/deskbridge.png",
      "assets/deskbridge.icns",
      "assets/deskbridge.ico"
    ],
    "macOS": {
      "infoPlist": "packaging/macos/Info.plist"
    }
  }
}
